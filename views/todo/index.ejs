<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TODO</title>
  <style>
    :root {
      --bg: #0c0c0e;
      --surface: #151518;
      --surface-hover: #1d1d22;
      --border: #2c2c33;
      --silver: #a8a8b3;
      --text: #f5f5f7;
      --muted: #72727d;
      --accent: #e5e5ea;
      --danger-bg: #241416;
      --danger-border: #6e2d35;
      --danger-text: #f3b5bc;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #18181d 0%, var(--bg) 55%);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      display: flex;
      justify-content: center;
      padding: 48px 16px;
    }

    .container {
      width: 100%;
      max-width: 640px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
      margin-bottom: 24px;
    }

    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--text);
    }

    .count {
      font-size: 13px;
      color: var(--silver);
      letter-spacing: 0.04em;
    }

    .error-banner {
      display: none;
      margin-bottom: 16px;
      padding: 12px 14px;
      border-radius: 8px;
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: var(--danger-text);
      font-size: 14px;
    }

    .error-banner.is-visible {
      display: block;
    }

    .todo-form {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
    }

    .todo-input {
      flex: 1;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 15px;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .todo-input::placeholder {
      color: var(--muted);
    }

    .todo-input:focus {
      border-color: var(--silver);
    }

    .add-btn {
      padding: 12px 20px;
      border-radius: 8px;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #0c0c0e;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.15s ease;
    }

    .add-btn:hover {
      opacity: 0.88;
    }

    .add-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .todo-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .todo-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .todo-item:hover {
      background: var(--surface-hover);
      border-color: #3c3c46;
    }

    .todo-label {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
      cursor: pointer;
    }

    .todo-checkbox {
      width: 18px;
      height: 18px;
      accent-color: var(--accent);
      cursor: pointer;
      flex-shrink: 0;
    }

    .todo-title {
      font-size: 15px;
      line-height: 1.5;
      word-break: break-word;
      color: var(--text);
    }

    .todo-item.is-completed .todo-title {
      color: var(--muted);
      text-decoration: line-through;
    }

    .delete-btn {
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--silver);
      font-size: 12px;
      cursor: pointer;
      flex-shrink: 0;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .delete-btn:hover {
      color: var(--text);
      border-color: var(--silver);
    }

    .empty-state {
      padding: 36px 16px;
      text-align: center;
      color: var(--muted);
      border: 1px dashed var(--border);
      border-radius: 10px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <main class="container">
    <header class="header">
      <h1>TODO</h1>
      <span id="todo-count" class="count">0 件</span>
    </header>

    <div id="error-banner" class="error-banner" role="alert"></div>

    <form id="todo-form" class="todo-form">
      <input
        id="todo-input"
        class="todo-input"
        type="text"
        maxlength="100"
        placeholder="タスクを入力（1〜100文字）"
        autocomplete="off"
        required
      />
      <button id="todo-submit" class="add-btn" type="submit">追加</button>
    </form>

    <ul id="todo-list" class="todo-list"></ul>
  </main>

  <script src="/todo/todo.js" defer></script>
</body>
</html>
